# Copy to .env and adjust. Every setting is prefixed with BAJA_.
BAJA_ENV="development"

# Signs and hashes tokens. Generate one with: openssl rand -hex 32
BAJA_SECRET=""

# Local Postgres. A Homebrew install uses your macOS username and no password.
BAJA_POSTGRES_USER="baja"
BAJA_POSTGRES_PWD=""
BAJA_POSTGRES_HOST="127.0.0.1"
BAJA_POSTGRES_PORT="5432"
BAJA_POSTGRES_DATABASE="baja"

# Local Redis: the job queue and rate limits.
BAJA_REDIS_HOST="127.0.0.1"
BAJA_REDIS_PORT="6379"
BAJA_REDIS_DB="0"
BAJA_REDIS_PASSWORD=""

# Public URLs of the API and the dashboard.
BAJA_BASE_URL="http://127.0.0.1:8000"
BAJA_FRONTEND_BASE_URL="http://127.0.0.1:3000"

# Email: "logger" prints emails in the worker output, "resend" sends them.
BAJA_EMAIL_SENDER="logger"
BAJA_EMAIL_FROM="Baja Luxury <noreply@bajaluxurymgmt.com>"
BAJA_RESEND_API_KEY=""
