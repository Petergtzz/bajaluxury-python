# Loaded after .env when BAJA_ENV=testing: values here win.
# Connection details (user, password, host, port) still come from your .env.
BAJA_ENV="testing"
BAJA_SECRET="testing-secret"
# Name prefix: each pytest worker creates and drops baja_testing_<worker>.
BAJA_POSTGRES_DATABASE="baja_testing"
BAJA_REDIS_DB="1"
BAJA_EMAIL_SENDER="logger"
BAJA_BASE_URL="http://test"
BAJA_FRONTEND_BASE_URL="http://app.test"
